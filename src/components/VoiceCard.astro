---
// const { category, text } = Astro.props;
---

<div class="voice_card">
  <h3>
    <slot name="category" />
  </h3>
  <div>
    <slot name="text" />
  </div>
</div>

<style>
  .voice_card {
    box-sizing: border-box;
    width: auto;
    border: 1px solid #ececec;
    border-radius: 8px;
    background-color: #fafafa;
    padding: 1.6rem;
    margin: 4rem auto;
    box-shadow: 2px 2px 10px 0px rgba(0, 0, 0, 0.2);
    max-width: 435px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 2s;
  }

  h3 {
    font-size: 1.8rem;
    margin-bottom: 1.6rem;
  }

@media screen and (width >= 768px) {
  .voice_card {
    width: 46%;
  }

  /* 奇数番目（1, 3, 5...番目）：左側 */
  .voice_card:nth-of-type(odd) {
    margin: 0 auto 0 2.4rem;

  }

  /* 偶数番目（2, 4, 6...番目）：右側 ＋ 上に持ち上げて重ねる */
  .voice_card:nth-of-type(even) {
    margin: 0 2.4rem 0 auto;
  }

  /* 4. 2番目以降：上に持ち上げて重ねる */
  .voice_card:not(:first-child) {
    margin-top: -9%;
  }
}
</style>

<script>
  import { ScrollObserver } from "./ScrollObserver";

  document.addEventListener("DOMContentLoaded", function () {
    const fadein = function (el, isIntersecting) {
      if (isIntersecting) {
        el.style.opacity = 1;
        el.style.transform = "none";
      }
    };
    new ScrollObserver(".voice_card", fadein, {
      rootMargin: "-200px 0px",
      threshold: 0,
    });
  });
</script>
